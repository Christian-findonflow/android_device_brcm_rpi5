diff --git a/res/layout/wifi_password_dialog.xml b/res/layout/wifi_password_dialog.xml
new file mode 100644
index 0000000..d8f7a63
--- /dev/null
+++ b/res/layout/wifi_password_dialog.xml
@@ -0,0 +1,102 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+    Copyright 2024 The Android Open Source Project
+
+    Licensed under the Apache License, Version 2.0 (the "License");
+    you may not use this file except in compliance with the License.
+    You may obtain a copy of the License at
+
+         http://www.apache.org/licenses/LICENSE-2.0
+
+    Unless required by applicable law or agreed to in writing, software
+    distributed under the License is distributed on an "AS IS" BASIS,
+    WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+    See the License for the specific language governing permissions and
+    limitations under the License.
+-->
+<!-- Custom compact WiFi password dialog for 800x480 screen -->
+<ScrollView
+    xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="300dp"
+    android:layout_height="wrap_content"
+    android:background="@drawable/wifi_dialog_background"
+    android:fillViewport="true">
+
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:orientation="vertical"
+        android:paddingStart="20dp"
+        android:paddingEnd="20dp"
+        android:paddingTop="16dp"
+        android:paddingBottom="16dp">
+
+        <!-- Title -->
+        <TextView
+            android:id="@+id/dialog_title"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:textAppearance="?android:attr/textAppearanceMedium"
+            android:textColor="?android:attr/textColorPrimary"
+            android:textStyle="bold"
+            android:ellipsize="end"
+            android:maxLines="2"
+            android:layout_marginBottom="16dp"/>
+
+        <!-- Password input -->
+        <EditText
+            android:id="@android:id/edit"
+            android:layout_width="match_parent"
+            android:layout_height="44dp"
+            android:textAlignment="viewStart"
+            android:hint="@string/wifi_password"
+            android:inputType="textPassword"
+            android:textAppearance="?android:attr/textAppearanceSmall"
+            android:background="@drawable/wifi_dialog_edittext_bg"
+            android:paddingStart="12dp"
+            android:paddingEnd="12dp"/>
+
+        <!-- Show password checkbox -->
+        <CheckBox
+            android:id="@+id/checkbox"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="8dp"
+            android:textAppearance="?android:attr/textAppearanceSmall"
+            android:minHeight="36dp"
+            android:text="@string/show_password"
+            android:buttonTint="?android:attr/colorAccent"/>
+
+        <!-- Button bar -->
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:orientation="horizontal"
+            android:gravity="end"
+            android:layout_marginTop="16dp">
+
+            <Button
+                android:id="@+id/button_cancel"
+                style="@style/WifiDialogButton"
+                android:layout_width="wrap_content"
+                android:layout_height="40dp"
+                android:minWidth="90dp"
+                android:text="@string/cancel"
+                android:layout_marginEnd="12dp"
+                android:background="@drawable/wifi_dialog_button_secondary"/>
+
+            <Button
+                android:id="@+id/button_ok"
+                style="@style/WifiDialogButton"
+                android:layout_width="wrap_content"
+                android:layout_height="40dp"
+                android:minWidth="90dp"
+                android:text="@string/okay"
+                android:background="@drawable/wifi_dialog_button_primary"
+                android:textColor="?android:attr/colorBackground"/>
+
+        </LinearLayout>
+
+    </LinearLayout>
+
+</ScrollView>
