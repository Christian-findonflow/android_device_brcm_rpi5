From d30a1b039ae537ba90d5c897368ef1b7995585d8 Mon Sep 17 00:00:00 2001
From: Christian <christian@find.xyz>
Date: Sat, 5 Sep 2026 23:27:24 +0000
Subject: [PATCH] bta_av: never feed source data into a stream where we are the
 sink

With source and sink profiles both enabled, the sink stream from the
phone is 'started' too and bta_av_ci_data() hands it the source
data-ready event: it pulled encoded frames from our encoder and pushed
them to the phone at full rate while the earbuds starved and dropped
their link. Guard bta_av_data_path() and bta_av_dup_audio_buf() on the
local SEP direction.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Change-Id: I59976da832c2160be999c99acfe8a64200c5450a
---
 system/bta/av/bta_av_aact.cc | 10 ++++++++++
 system/bta/av/bta_av_main.cc |  3 +++
 2 files changed, 13 insertions(+)

diff --git a/system/bta/av/bta_av_aact.cc b/system/bta/av/bta_av_aact.cc
index 7cf03c3..adbd5d1 100644
--- a/system/bta/av/bta_av_aact.cc
+++ b/system/bta/av/bta_av_aact.cc
@@ -2111,6 +2111,16 @@ void bta_av_data_path(tBTA_AV_SCB* p_scb, tBTA_AV_DATA* /* p_data */) {
     return;
   }
 
+  // NEO dash: with the source and sink profiles both enabled, a stream on
+  // which WE are the sink (the phone playing into us) is "started" too, and
+  // bta_av_ci_data() hands it the source data-ready event like any other
+  // audio stream. It must never pull encoded frames from our encoder or push
+  // them at the phone: on 2026-09-05 the dash sent the earbud stream to the
+  // phone at full rate while the earbuds themselves were starved.
+  if (p_scb->seps[p_scb->sep_idx].tsep != AVDT_TSEP_SRC) {
+    return;
+  }
+
   if (p_scb->cong) {
     return;
   }
diff --git a/system/bta/av/bta_av_main.cc b/system/bta/av/bta_av_main.cc
index 54678f0..655713e 100644
--- a/system/bta/av/bta_av_main.cc
+++ b/system/bta/av/bta_av_main.cc
@@ -1026,6 +1026,9 @@ void bta_av_dup_audio_buf(tBTA_AV_SCB* p_scb, BT_HDR* p_buf) {
     if ((p_scbi == NULL) || !p_scbi->co_started) {
       continue; /* Ignore if SCB is not used or started */
     }
+    if (p_scbi->seps[p_scbi->sep_idx].tsep != AVDT_TSEP_SRC) {
+      continue; /* NEO dash: we are the sink on this stream (phone -> us) */
+    }
     if (!(bta_av_cb.conn_audio & BTA_AV_HNDL_TO_MSK(i))) {
       continue; /* Audio is not connected */
     }
-- 
