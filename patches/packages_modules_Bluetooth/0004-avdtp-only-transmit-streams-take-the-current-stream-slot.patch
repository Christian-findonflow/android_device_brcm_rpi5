From ab129d0889f2d63901b609a0e1e55c3d61a5acc3 Mon Sep 17 00:00:00 2001
From: Christian <christian@find.xyz>
Date: Sat, 5 Sep 2026 23:38:05 +0000
Subject: [PATCH] avdtp: only transmit streams compete for the current-stream
 slot

avdt_scb_event() lets a single 'current' stream send when more than one
stream is in the streaming state. It counted the stream on which our
local SEP is a sink (the phone playing into us), so the earbud stream
never got the slot and every media packet was freed ('ignore
AVDT_SCB_API_WRITE_REQ_EVT' at 43/s). Count only SRC-side streams.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Change-Id: Iab2d93da6e68dfa49430f276b269a1a4f37f081b
---
 system/stack/avdt/avdt_scb.cc | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/system/stack/avdt/avdt_scb.cc b/system/stack/avdt/avdt_scb.cc
index 1e1d7ae..ae1cd09 100644
--- a/system/stack/avdt/avdt_scb.cc
+++ b/system/stack/avdt/avdt_scb.cc
@@ -772,7 +772,13 @@ void avdt_scb_event(AvdtpScb* p_scb, uint8_t event, tAVDT_SCB_EVT* p_data) {
   for (int i = 0; i < AVDT_NUM_LINKS; i++) {
     for (int j = 0; j < AVDT_NUM_SEPS; j++) {
       AvdtpScb* p_avdt_scb = &avdtp_cb.ccb[i].scb[j];
-      if (p_avdt_scb->allocated && avdt_scb_st_tbl[p_avdt_scb->state] == avdt_scb_st_stream) {
+      // NEO dash: the "one current stream" rule is about which of several
+      // TRANSMIT streams may send. A stream on which our local SEP is a
+      // sink (the phone playing into us) is streaming too, but it never
+      // transmits; counting it left the earbud stream without the transmit
+      // slot and every media packet was freed here (2026-09-05).
+      if (p_avdt_scb->allocated && avdt_scb_st_tbl[p_avdt_scb->state] == avdt_scb_st_stream &&
+          p_avdt_scb->stream_config.tsep == AVDT_TSEP_SRC) {
         num_st_streams++;
         ccb_index = i;
         scb_index = j;
-- 
