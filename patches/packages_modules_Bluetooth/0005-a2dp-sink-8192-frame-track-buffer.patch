From ed2a9347a73a55c278ec41badda73d88676b64ad Mon Sep 17 00:00:00 2001
From: Christian <christian@find.xyz>
Date: Sat, 5 Sep 2026 23:45:47 +0000
Subject: [PATCH] a2dp sink: 8192-frame track buffer so packet bursts never
 drop

The phone delivers A2DP packets in bursts of two or three; the stock
LOW_LATENCY stream got a 2052-frame (46 ms) AudioTrack, so a burst did
not fit and one packet was dropped every few seconds - an audible tick
in the earbuds. Share one builder between the create and reconnect
paths, ask for 8192 frames, performance mode NONE.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Change-Id: I12be14fd08cce659937f737ed6d4f48d9cc80569
---
 system/btif/src/btif_avrcp_audio_track.cc | 43 +++++++++++++----------
 1 file changed, 25 insertions(+), 18 deletions(-)

diff --git a/system/btif/src/btif_avrcp_audio_track.cc b/system/btif/src/btif_avrcp_audio_track.cc
index d15c855..6a81a6b 100644
--- a/system/btif/src/btif_avrcp_audio_track.cc
+++ b/system/btif/src/btif_avrcp_audio_track.cc
@@ -58,20 +58,38 @@ static struct AudioEngine {
 
 static void ErrorCallback(AAudioStream* stream, void* userdata, aaudio_result_t error);
 
-static void BtifAvrcpAudioErrorHandle() {
+// NEO dash: the phone delivers A2DP packets in bursts of two or three (23 ms
+// of audio each) and the output is a second Bluetooth link. With the stock
+// LOW_LATENCY request the AudioTrack behind this stream held 2052 frames
+// (46 ms), so a three-packet burst never fit and one packet was dropped
+// every few seconds - audible as a tick in the earbuds (2026-09-05). Ask
+// for a buffer that swallows any burst; music does not care about 190 ms.
+constexpr int32_t kTrackBufferCapacityFrames = 8192;
+
+static AAudioStream* openSinkStream(int trackFreq, int channelCount) {
   AAudioStreamBuilder* builder;
-  AAudioStream* stream;
-
+  AAudioStream* stream = nullptr;
   aaudio_result_t result = AAudio_createStreamBuilder(&builder);
-  AAudioStreamBuilder_setSampleRate(builder, s_AudioEngine.trackFreq);
+  log::assert_that(result == AAUDIO_OK, "assert failed: createStreamBuilder");
+  AAudioStreamBuilder_setSampleRate(builder, trackFreq);
   AAudioStreamBuilder_setFormat(builder, AAUDIO_FORMAT_PCM_FLOAT);
-  AAudioStreamBuilder_setChannelCount(builder, s_AudioEngine.channelCount);
+  AAudioStreamBuilder_setChannelCount(builder, channelCount);
   AAudioStreamBuilder_setSessionId(builder, AAUDIO_SESSION_ID_ALLOCATE);
-  AAudioStreamBuilder_setPerformanceMode(builder, AAUDIO_PERFORMANCE_MODE_LOW_LATENCY);
+  AAudioStreamBuilder_setPerformanceMode(builder, AAUDIO_PERFORMANCE_MODE_NONE);
+  AAudioStreamBuilder_setBufferCapacityInFrames(builder, kTrackBufferCapacityFrames);
   AAudioStreamBuilder_setErrorCallback(builder, ErrorCallback, nullptr);
   result = AAudioStreamBuilder_openStream(builder, &stream);
   log::assert_that(result == AAUDIO_OK, "assert failed: result == AAUDIO_OK");
   AAudioStreamBuilder_delete(builder);
+  const int32_t capacity = AAudioStream_getBufferCapacityInFrames(stream);
+  AAudioStream_setBufferSizeInFrames(stream, capacity);
+  log::info("sink track: {} Hz, {} ch, buffer capacity {} frames, size {} frames", trackFreq,
+            channelCount, capacity, AAudioStream_getBufferSizeInFrames(stream));
+  return stream;
+}
+
+static void BtifAvrcpAudioErrorHandle() {
+  AAudioStream* stream = openSinkStream(s_AudioEngine.trackFreq, s_AudioEngine.channelCount);
 
   BtifAvrcpAudioTrack* trackHolder = static_cast<BtifAvrcpAudioTrack*>(s_AudioEngine.trackHandle);
 
@@ -96,18 +114,7 @@ void* BtifAvrcpAudioTrackCreate(int trackFreq, int bitsPerSample, int channelCou
   log::info("Track.cpp: btCreateTrack freq {} bps {} channel {}", trackFreq, bitsPerSample,
             channelCount);
 
-  AAudioStreamBuilder* builder;
-  AAudioStream* stream;
-  aaudio_result_t result = AAudio_createStreamBuilder(&builder);
-  AAudioStreamBuilder_setSampleRate(builder, trackFreq);
-  AAudioStreamBuilder_setFormat(builder, AAUDIO_FORMAT_PCM_FLOAT);
-  AAudioStreamBuilder_setChannelCount(builder, channelCount);
-  AAudioStreamBuilder_setSessionId(builder, AAUDIO_SESSION_ID_ALLOCATE);
-  AAudioStreamBuilder_setPerformanceMode(builder, AAUDIO_PERFORMANCE_MODE_LOW_LATENCY);
-  AAudioStreamBuilder_setErrorCallback(builder, ErrorCallback, nullptr);
-  result = AAudioStreamBuilder_openStream(builder, &stream);
-  log::assert_that(result == AAUDIO_OK, "assert failed: result == AAUDIO_OK");
-  AAudioStreamBuilder_delete(builder);
+  AAudioStream* stream = openSinkStream(trackFreq, channelCount);
 
   BtifAvrcpAudioTrack* trackHolder = new BtifAvrcpAudioTrack;
   log::assert_that(trackHolder != NULL, "assert failed: trackHolder != NULL");
-- 
