-constexpr int64_t kTimeoutNanos = 100 * 1000 * 1000;  // 100 ms
+// NEO dash (Raspberry Pi 5, no local audio output): the sink's PCM goes to
+// an AudioTrack whose output is a *second* Bluetooth link (the earbuds).  The
+// legacy AAudio path used on this HAL ignores the timeout argument of
+// AAudioStream_write() and blocks until every frame fits in the track buffer.
+// The buffer only drains once the earbud stream has started, and that start
+// needs the stack's main thread, which by then is parked on g_mutex in
+// btif_a2dp_sink_enqueue_buf() waiting for *this* worker.  The three-way wait
+// froze the whole stack for minutes on 2026-09-05.  Write without blocking,
+// give the consumer a short grace period, then drop what still does not fit:
+// a dropped frame costs a click, a blocked worker costs the radio.
+constexpr int64_t kWriteBudgetNanos = 20 * 1000 * 1000;  // 20 ms
+constexpr int64_t kWritePollNanos = 2 * 1000 * 1000;     // 2 ms
+constexpr int64_t kDropLogIntervalNanos = 1000 * 1000 * 1000;  // 1 s
+
+static int64_t monotonicNanos() {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return static_cast<int64_t>(ts.tv_sec) * 1000000000LL + ts.tv_nsec;
+}
+
+// Writes |frames| frames from |data| without ever blocking for longer than
+// kWriteBudgetNanos.  Returns the number of frames written, or a negative
+// AAudio result.
+static int32_t writeBounded(AAudioStream* stream, const float* data, int32_t frames,
+                            int32_t channelCount) {
+  const int64_t deadline = monotonicNanos() + kWriteBudgetNanos;
+  int32_t written = 0;
+  while (written < frames) {
+    aaudio_result_t result = AAudioStream_write(stream, data + written * channelCount,
+                                                frames - written, 0 /* non-blocking */);
+    if (result < 0) {
+      return result;
+    }
+    written += result;
+    if (written >= frames || monotonicNanos() >= deadline) {
+      break;
+    }
+    std::this_thread::sleep_for(std::chrono::nanoseconds(kWritePollNanos));
+  }
+  return written;
+}
 
