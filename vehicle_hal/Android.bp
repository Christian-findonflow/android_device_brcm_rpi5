package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_static {
    name: "MotorcycleVehicleHardware",
    vendor: true,
    // Host variant: lets the decode logic run in host unit tests and the
    // vcan replay tool without flashing a device (see tests/TESTING.md).
    host_supported: true,
    defaults: [
        "VehicleHalDefaults",
    ],
    local_include_dirs: ["."],
    export_include_dirs: ["."],
    srcs: ["MotorcycleVehicleHardware.cpp"],
    header_libs: [
        "IVehicleHardware",
    ],
    static_libs: [
        "VehicleHalUtils",
    ],
    shared_libs: [
        "libbinder_ndk",
        "libcutils",
    ],
}

cc_binary {
    name: "android.hardware.automotive.vehicle@V4-motorcycle-service",
    vendor: true,
    defaults: [
        "VehicleHalDefaults",
        "android-automotive-large-parcelable-defaults",
    ],
    vintf_fragments: ["vhal-motorcycle-service.xml"],
    init_rc: ["vhal-motorcycle-service.rc"],
    relative_install_path: "hw",
    srcs: ["VehicleService.cpp"],
    local_include_dirs: ["."],
    static_libs: [
        "DefaultVehicleHal",
        "MotorcycleVehicleHardware",
        "VehicleHalUtils",
    ],
    header_libs: [
        "IVehicleHardware",
    ],
    shared_libs: [
        "libbinder_ndk",
    ],
}

// Host-side unit tests for the CAN decode and config logic.
// Run: atest --host motorcycle_vhal_test
cc_test {
    name: "motorcycle_vhal_test",
    host_supported: true,
    device_supported: false,
    defaults: ["VehicleHalDefaults"],
    srcs: ["tests/MotorcycleVehicleHardwareTest.cpp"],
    static_libs: [
        "MotorcycleVehicleHardware",
        "VehicleHalUtils",
    ],
    header_libs: [
        "IVehicleHardware",
    ],
    shared_libs: [
        "libbinder_ndk",
        "libcutils",
    ],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
}

// Host replay tool: runs the real HAL decode stack against a local vcan
// interface so captured bus traffic can be replayed on the dev machine.
// See tests/TESTING.md.
cc_binary {
    name: "motorcycle_vhal_replay",
    host_supported: true,
    device_supported: false,
    defaults: ["VehicleHalDefaults"],
    srcs: ["tests/VhalReplayTool.cpp"],
    static_libs: [
        "MotorcycleVehicleHardware",
        "VehicleHalUtils",
    ],
    header_libs: [
        "IVehicleHardware",
    ],
    shared_libs: [
        "libbinder_ndk",
        "libcutils",
    ],
}

// CAN frame sender/replayer for simulator and bench testing (the platform
// image has no can-utils). Host variant included for symmetry with vcan on
// the dev machine.
cc_binary {
    name: "moto_can_replay",
    vendor: true,
    host_supported: true,
    srcs: ["tests/CanReplayer.cpp"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
