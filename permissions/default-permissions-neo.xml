<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-granted runtime permissions for the NEO motorcycle dashboard.

  A rider cannot answer a permission dialog, so anything the dashboard needs is
  granted here. fixed="false" keeps them user-revocable in Settings.

  READ_CAR_EXTERIOR_LIGHTS is a *dangerous* (runtime) permission, not
  signature|privileged - allowlisting it in privapp-permissions has no effect.
  Without this grant, registering TURN_SIGNAL_LIGHT_STATE and
  HIGH_BEAM_LIGHTS_STATE throws SecurityException, which both the launcher and
  SystemUI swallow, so the indicators silently never light.
-->
<exceptions>
    <exception package="com.android.car.carlauncher">
        <permission name="android.car.permission.READ_CAR_EXTERIOR_LIGHTS" fixed="false"/>
    </exception>
    <exception package="com.android.systemui">
        <permission name="android.car.permission.READ_CAR_EXTERIOR_LIGHTS" fixed="false"/>
    </exception>
    <exception package="com.android.car.media.localmediaplayer">
        <permission name="android.permission.READ_EXTERNAL_STORAGE" fixed="false"/>
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false"/>
    </exception>
    <exception package="net.osmand">
        <permission name="android.permission.ACCESS_FINE_LOCATION" fixed="false"/>
        <permission name="android.permission.ACCESS_COARSE_LOCATION" fixed="false"/>
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="false"/>
    </exception>
</exceptions>
