# SELinux policy for Motorcycle Vehicle HAL service
# Extends hal_can_socketcan to also serve as Vehicle HAL

# Allow hal_can_socketcan to also serve Vehicle HAL
hal_server_domain(hal_can_socketcan, hal_vehicle)

# GPIO access for turn signals and high beam indicators
# Allow access to GPIO character devices
allow hal_can_socketcan gpio_device:chr_file rw_file_perms;

# Allow access to sysfs GPIO interface
allow hal_can_socketcan sysfs_gpio:dir r_dir_perms;
allow hal_can_socketcan sysfs_gpio:file rw_file_perms;

# Allow reading vendor properties for GPIO configuration
get_prop(hal_can_socketcan, vendor_default_prop)

# Allow reading and persisting motodash configuration properties
# (set_prop implies get_prop)
set_prop(hal_can_socketcan, vendor_motodash_prop)

# CAN capture (VENDOR_CFG_CAN_CAPTURE): candump-format logs under /data/vendor/motodash
allow hal_can_socketcan motodash_data_file:dir create_dir_perms;
allow hal_can_socketcan motodash_data_file:file create_file_perms;

# Lean sensor (ISM330DHCX) + barometer (BMP280) on /dev/i2c-1, spoken to
# directly with the I2C_RDWR ioctl (see vehicle_hal/imu/).
allow hal_can_socketcan i2c_device:chr_file rw_file_perms;
